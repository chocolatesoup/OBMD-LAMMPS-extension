name: Compile LAMMPS

on:
  push:
    paths:
      - '.github/**'
      - 'code/**'
      - 'OBMD_DPD/**'
jobs:
  build:
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os:
          - ubuntu-24.04-arm
          - ubuntu-24.04
    steps:
    - uses: actions/checkout@v4
    - uses: eessi/github-action-eessi@v3
    - name: set up EasyBuild
      run: |
        pwd
        module load EESSI-extend/2023.06-easybuild
        eb --show-config
        echo "Get EasyConfig"
        # Can change the LAMMPS commit which will be build by updating LAMMPS_COMMIT_BUILD https://github.com/laraPPr/lammps/settings/variables/actions
        eb .github/workflows/LAMMPS_OBMD-foss-2023b-software-commit.eb --software-commit ${{ vars.LAMMPS_COMMIT_BUILD }}
        module avail LAMMPS
        module load LAMMPS/${{ vars.LAMMPS_COMMIT_BUILD }}-foss-2023a-kokkos-dev_OBMD
        echo $EBROOTLAMMPS
        ls $EBROOTLAMMPS
        python3 examples/OBMD_DPD/input.py
        mpirun --oversubscribe -np 4 lmp -in in.simulation 
